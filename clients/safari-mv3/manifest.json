{
  "manifest_version": 3,
  "name": "Conduit",
  "version": "0.1.0",
  "description": "typed, scoped tunnel from this browser to a conduit client",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "wss://broker.example/*",
    "https://broker.example/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Conduit",
    "default_popup": "popup.html"
  }
}
