sequenceDiagram
  participant near-end
  participant broker
  participant user
  near-end->>broker: POST /v1/device/code
  broker-->>near-end: code + url (10m)
  near-end->>user: show code
  user->>broker: approve on page
  near-end->>broker: POST /v1/device/secret
  broker-->>near-end: 256-bit secret
