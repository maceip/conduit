sequenceDiagram
  participant extension
  participant broker
  participant client
  extension->>broker: hello: key, last seq
  client->>broker: hello: key, last seq
  broker-->>client: welcome + missed frames
  extension->>broker: publish, sealed
  broker-->>client: publish, still sealed
  client->>broker: call, sealed
  broker->>extension: call
  extension->>broker: result, sealed
  broker-->>client: result
